    <!-- http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#administra_recurso -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#administra_recurso">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#Sistema_Operativo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#Recurso_Memoria_Almacenamiento"/>
        <rdfs:comment>Conecta el SO con la RAM gestionada, las particiones Swap, o discos físicos</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#ejecuta_componente -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#ejecuta_componente">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#es_variante_de -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#es_variante_de">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#Sistema_Operativo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#Sistema_Operativo"/>
        <rdfs:comment>Para indicar que Ubuntu es variante de Debian, o Windows 11 de Windows 10.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#esta_formateado_con -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#esta_formateado_con">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#Recurso_Memoria_Almacenamiento"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#Sistema_Archivos"/>
        <rdfs:comment>Para enlazar directamente que una partición física de disco tiene un formato ext4, independientemente del SO.</rdfs:comment>
    </owl:ObjectProperty>
    


