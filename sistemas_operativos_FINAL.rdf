    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->

    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#Sistema_Operativo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#Componente_Software_Base"/>
        <rdfs:comment>Para conectar el SO con sus demonios (ej. systemd), controladores o librerías gráficas.</rdfs:comment>
    </rdf:Description>
    


