    <!-- http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#utiliza_licencia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/administrator/ontologies/2026/2/untitled-ontology-2#utiliza_licencia">
